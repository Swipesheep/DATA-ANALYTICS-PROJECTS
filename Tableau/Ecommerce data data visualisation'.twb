      </column>
      <column caption='Age group' datatype='string' name='[Age_group]' role='dimension' type='nominal' />
      <column caption='Churn Risk Category' datatype='string' name='[Calculation_1213633162948609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Churn Risk Score] &lt;= 60 THEN &quot;Low Risk&quot;&#13;&#10;ELSEIF [Churn Risk Score] &lt;= 80 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;High Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Active customers' datatype='integer' name='[Calculation_1213633172385795]' role='measure' type='quantitative'>
