      <column caption='Paused customers' datatype='integer' name='[Active customers (copy) (copy)_1213633172553733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [subscription_status] = &quot;paused&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Cancelled customers ' datatype='integer' name='[Active customers (copy)_1213633172545540]' role='measure' type='quantitative'>
